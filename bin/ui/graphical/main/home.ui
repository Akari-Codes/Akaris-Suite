<style>
    body {background-color: rgb(48, 48, 48);color:white;font-family: Arial, Helvetica, sans-serif;}
    #title_block {text-align: center;}
    #title {color:magenta;}
    #tool_block {margin:5px;display: block;text-align: center; align-content: center;}
    .tool_container {text-align: left;background-color: purple;padding:10px;border-radius: 20px;border:none}
    .tool_title {color:whtie;}
    .tool_desc {color:grey}
    .tool_btn {color:white;background-color: magenta;border:none;border-radius: 7px;}
    .tool_btn:hover {background-color: rgb(82, 0, 82);}

</style>
<html>
<title>Akari's Suite - Home</title>
    <body>
        <div id="title_block">
            <h2 id="title">Akari's Suite</h2>
        </div>
        <div id="tool_block">
            <div class="tool_container">
                <h3 class="tool_title">Encryption and Decryption Tools</h3>
                <p class="tool_desc">Encrypt and decrypt your files with ease. Make notes using a secure text editor to create encrypted notes.</p>
                <button onclick="pywebview.api.interface('enc')", class="tool_btn">Open</button>
            </div><br>
            <div class="tool_container">
                <h3 class="tool_title">Program Compiler Tool</h3>
                <p class="tool_desc">Encrypt and decrypt your files with ease. Make notes using a secure text editor to create encrypted notes.</p>
                <button onclick="pywebview.api.interface('p_compiler')", class="tool_btn">Open</button>
            </div><br>
        </div>
    </body>
    <footer>
        <div></div>
    </footer>
</html>